<?xml version="1.0" encoding="UTF-8"?>
<!-- custom/imported/samples.xml: generated by the importer. One <sample> per imported sample runner;
     href is relative to custom/imported/ and points at a character file (character.xsd). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="samples">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sample" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="source" type="xs:string" use="required"/>
            <xs:attribute name="href" type="xs:string" use="required"/>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="role" type="xs:string"/>
            <xs:attribute name="page" type="xs:positiveInteger"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
