<?xml version="1.0" encoding="UTF-8"?>
<!-- library/<book-id>/review.xml: AI proposals for a book no recipe knows, and the user's decisions.
     Each proposal holds one entry exactly as it would go in the overlay (amps.xsd / items.xsd) and
     the validation notes. kind names the overlay: amp, gear, weapon, armor, spell, complex-form.
     source is provisional until the user picks one. The file is rewritten after each of the book.md
     parts (done of parts; bookSha256 = the book.md proposed), so an unfinished run can resume.
     <skip part> = a part whose reply was cut off or had no usable JSON, with the reason. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="review">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="skip" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="part" type="xs:positiveInteger" use="required"/>
          </xs:extension></xs:simpleContent></xs:complexType>
        </xs:element>
        <xs:element name="proposal" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:choice>
                <xs:element name="amp" type="xs:anyType"/>
                <xs:element name="item" type="xs:anyType"/>
              </xs:choice>
              <xs:element name="note" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="kind" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="amp"/><xs:enumeration value="gear"/><xs:enumeration value="weapon"/>
                <xs:enumeration value="armor"/><xs:enumeration value="spell"/><xs:enumeration value="complex-form"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="state" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="pending"/><xs:enumeration value="accepted"/>
                <xs:enumeration value="edited"/><xs:enumeration value="dropped"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="page" type="xs:positiveInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="book" type="xs:string" use="required"/>
      <xs:attribute name="source" type="xs:string" use="required"/>
      <!-- true: rows for core tables the book's recipe couldn't read (applied to custom/imported/core/) -->
      <xs:attribute name="core" type="xs:boolean"/>
      <xs:attribute name="provider" type="xs:string"/>
      <xs:attribute name="created" type="xs:dateTime" use="required"/>
      <xs:attribute name="bookSha256" type="xs:string" use="required"/>
      <xs:attribute name="parts" type="xs:nonNegativeInteger" use="required"/>
      <xs:attribute name="done" type="xs:nonNegativeInteger" use="required"/>
    </xs:complexType>
    <xs:unique name="proposalId"><xs:selector xpath="proposal"/><xs:field xpath="@id"/></xs:unique>
  </xs:element>
</xs:schema>
