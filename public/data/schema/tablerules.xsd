<?xml version="1.0" encoding="UTF-8"?>
<!-- custom/table-rules.xml: the GM's table rules (Rules page), written by the server (server/books.mjs PUT /api/table-rules);
     anyone signed in reads it at /custom/table-rules.xml. A rule without <name> is a book's optional rule (a rules entry with
     sheet="optional", by its scoped id); one with <name> is a house rule the GM wrote. on="true": in play at this table. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:config:1"
           targetNamespace="urn:chummer-anarchy2:config:1"
           elementFormDefault="unqualified">
  <xs:element name="tablerules">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rule" minOccurs="0" maxOccurs="200">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element name="name"><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="120"/></xs:restriction></xs:simpleType></xs:element>
              <xs:element name="text"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="4000"/></xs:restriction></xs:simpleType></xs:element>
            </xs:sequence>
            <xs:attribute name="id" use="required">
              <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[a-z0-9][a-z0-9.\-]{0,99}"/></xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="on" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
    <xs:unique name="one-per-id"><xs:selector xpath="rule"/><xs:field xpath="@id"/></xs:unique>
  </xs:element>
</xs:schema>
