<?xml version="1.0" encoding="UTF-8"?>
<!-- library/.config/ai-keys.xml (mode 600): one API key per AI provider and nothing else. Never served. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:config:1"
           targetNamespace="urn:chummer-anarchy2:config:1"
           elementFormDefault="unqualified">
  <xs:simpleType name="Provider">
    <xs:restriction base="xs:string">
      <xs:enumeration value="anthropic"/><xs:enumeration value="openai"/>
      <xs:enumeration value="gemini"/><xs:enumeration value="anythingllm"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="aikeys">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="key" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="provider" type="ca2:Provider" use="required"/>
          </xs:extension></xs:simpleContent></xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
    <xs:unique name="oneKeyPerProvider"><xs:selector xpath="key"/><xs:field xpath="@provider"/></xs:unique>
  </xs:element>
</xs:schema>
