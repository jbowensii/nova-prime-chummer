<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared types for every Chummer Anarchy 2.0 data file. See docs/data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:data:1"
           targetNamespace="urn:chummer-anarchy2:data:1"
           elementFormDefault="unqualified">

  <xs:simpleType name="Id">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdList">
    <xs:list itemType="ca2:Id"/>
  </xs:simpleType>

  <xs:simpleType name="Attr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="str"/><xs:enumeration value="agi"/><xs:enumeration value="wil"/>
      <xs:enumeration value="log"/><xs:enumeration value="cha"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- id + citation carried by every entry -->
  <xs:attributeGroup name="ref">
    <xs:attribute name="id" type="ca2:Id" use="required"/>
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="page" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- overlay files delete a base entry with <remove id="..."/> -->
  <xs:complexType name="Remove">
    <xs:attribute name="id" type="ca2:Id" use="required"/>
  </xs:complexType>

  <xs:attributeGroup name="root">
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- an amp's or item's <formula>s and <issue>s, just before its description (src/engine/formula.ts, docs/data-format.md):
       how a field is worked out (an item's cost: B is the standard price from pricing.xml), and a field the book prints
       nothing for or the importer couldn't read. The edits layer doesn't store them (an edit keeps the book's). -->
  <xs:simpleType name="Field">
    <xs:restriction base="xs:string"><xs:pattern value="[a-zA-Z][a-zA-Z0-9]*"/></xs:restriction>
  </xs:simpleType>
  <xs:group name="extras">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="formula">
          <xs:complexType><xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="field" type="ca2:Field" use="required"/>
            <xs:attribute name="round"><xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="up"/><xs:enumeration value="down"/></xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="unit" type="xs:string"/>
            <xs:attribute name="qty" type="xs:string"/>
          </xs:extension></xs:simpleContent></xs:complexType>
        </xs:element>
        <xs:element name="issue">
          <xs:complexType><xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="field" type="ca2:Field" use="required"/>
            <xs:attribute name="code" use="required"><xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="missing"/><xs:enumeration value="unreadable"/><xs:enumeration value="ambiguous"/></xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="page" type="xs:positiveInteger"/>
          </xs:extension></xs:simpleContent></xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:sequence>
  </xs:group>

  <!-- An effect (amps, items, metatypes): an Amp effect id or a narrative effect kind (src/engine/amps.ts RULE_EFFECTS),
       its param (a skill, spec, attribute, realm or Test id, or text), its value (points, drones, a drawback's size) -->
  <xs:complexType name="Effect">
    <xs:attribute name="ref" type="ca2:Id" use="required"/>
    <xs:attribute name="param" type="xs:string"/>
    <xs:attribute name="value" type="xs:positiveInteger"/>
    <xs:attribute name="note" type="xs:string"/>
    <!-- how it is turned on (none: always on) and whether it counts: src/engine/effects.ts. when: only then (shown, not
         counted); confidence low: shown, not counted; from: the catalog id of the entry it is given by -->
    <xs:attribute name="switch">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="wireless"/><xs:enumeration value="activated"/><xs:enumeration value="sustained"/><xs:enumeration value="conditional"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="when" type="xs:string"/>
    <xs:attribute name="confidence"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="low"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="from" type="xs:string"/>
    <xs:attribute name="affects"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="caster"/><xs:enumeration value="target"/></xs:restriction></xs:simpleType></xs:attribute>
    <!-- a book effect its printed rating doesn't pay for: it applies, at rating 0 -->
    <xs:attribute name="unpriced" type="xs:boolean"/>
  </xs:complexType>

  <!-- entry types of amps.xsd, items.xsd and rules.xsd (also the edits layer, edits.xsd, and compendium.xsd) -->
  <xs:complexType name="Amp">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <!-- equipment amps: the base item bought with the amp (priced from pricing.xml) -->
      <xs:element name="item" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="gear"/><xs:enumeration value="weapon"/><xs:enumeration value="armor"/>
            </xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="specialist" type="xs:boolean"/>
          <xs:attribute name="armor" type="xs:positiveInteger"/>
          <xs:attribute name="dv" type="xs:string"/>
          <xs:attribute name="ranges" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="effect" type="ca2:Effect" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="ca2:extras"/>
      <xs:element name="narrative" type="xs:string"/>
    </xs:sequence>
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="type" type="ca2:Id" use="required"/>
    <xs:attribute name="printedRating" type="xs:integer"/>
    <xs:attribute name="vehicle" type="ca2:Id"/>
    <xs:attribute name="mod" type="xs:boolean"/>
  </xs:complexType>
  <xs:complexType name="Item">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <!-- what it does, read from its text by the importer (a spell's Advantage, a drug's Disadvantage) -->
      <xs:element name="effect" type="ca2:Effect" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="ca2:extras"/>
      <xs:element name="text" type="xs:string"/>
    </xs:sequence>
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="kind" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="gear"/><xs:enumeration value="weapon"/><xs:enumeration value="armor"/><xs:enumeration value="spell"/><xs:enumeration value="complex-form"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="specialist" type="xs:boolean"/>
    <xs:attribute name="armor" type="xs:positiveInteger"/>
    <xs:attribute name="dv" type="xs:string"/>
    <xs:attribute name="ranges" type="xs:string"/>
    <xs:attribute name="category" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="Rule">
    <xs:sequence><xs:element name="title" type="xs:string"/><xs:element name="text" type="xs:string"/></xs:sequence>
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="sheet" type="ca2:Id" use="required"/>
    <xs:attribute name="section" type="xs:string"/>
    <xs:attribute name="effects" type="ca2:IdList"/>
  </xs:complexType>
  <!-- vehicles.xsd and compendium.xsd -->
  <xs:complexType name="Vehicle">
    <xs:sequence><xs:element name="name" type="xs:string"/></xs:sequence>
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="pilot" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="body" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="handling" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="speed" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="flyingSpeed" type="xs:nonNegativeInteger"/>
    <xs:attribute name="armor" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="mount" type="xs:string" use="required"/>
  </xs:complexType>
</xs:schema>
