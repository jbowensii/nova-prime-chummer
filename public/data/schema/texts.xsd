<?xml version="1.0" encoding="UTF-8"?>
<!-- Private descriptions (book-derived text) kept out of the repository and merged by id at load.
     of="amps" fills an amp's narrative, of="items" an item's text, of="rules" a rule's text. See docs/data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:data:1"
           targetNamespace="urn:chummer-anarchy2:data:1"
           elementFormDefault="unqualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="data">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="text" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="of" use="required">
              <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="amps"/><xs:enumeration value="items"/><xs:enumeration value="rules"/></xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="id" type="ca2:Id" use="required"/>
          </xs:extension></xs:simpleContent></xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="texts"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="ca2:root"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
