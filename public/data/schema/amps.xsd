<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for kind="amps". See docs/data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:data:1"
           targetNamespace="urn:chummer-anarchy2:data:1"
           elementFormDefault="unqualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="data">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="amp" type="ca2:Amp"/>
        <xs:element name="remove" type="ca2:Remove"/>
      </xs:choice>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="amps"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="ca2:root"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Amp">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="effect" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="ref" type="ca2:Id" use="required"/>
          <xs:attribute name="param" type="xs:string"/>
          <xs:attribute name="value" type="xs:positiveInteger"/>
          <xs:attribute name="note" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="narrative" type="xs:string"/>
    </xs:sequence>
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="type" type="ca2:Id" use="required"/>
    <xs:attribute name="printedRating" type="xs:integer"/>
    <xs:attribute name="vehicle" type="ca2:Id"/>
  </xs:complexType>
</xs:schema>
