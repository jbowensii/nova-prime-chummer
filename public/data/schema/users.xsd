<?xml version="1.0" encoding="UTF-8"?>
<!-- library/.config/users.xml (accounts), sessions.xml (session hashes) and reset.xml (a recovery code's hash, from
     `node server/users.mjs reset <user>`). Written by the server (server/auth.mjs); never served, never plain secrets. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:config:1"
           targetNamespace="urn:chummer-anarchy2:config:1"
           elementFormDefault="unqualified">
  <xs:simpleType name="UserId"><xs:restriction base="xs:string"><xs:pattern value="[0-9a-f]{12}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Username"><xs:restriction base="xs:string"><xs:pattern value="[a-z0-9][a-z0-9._\-]{1,31}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Sha256"><xs:restriction base="xs:string"><xs:pattern value="[0-9a-f]{64}"/></xs:restriction></xs:simpleType>

  <xs:element name="users">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="user" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!-- app password accounts: scrypt, its parameters kept per hash so they can be raised later -->
              <xs:element name="password" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="algorithm" use="required">
                    <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="scrypt"/></xs:restriction></xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="N" type="xs:positiveInteger" use="required"/>
                  <xs:attribute name="r" type="xs:positiveInteger" use="required"/>
                  <xs:attribute name="p" type="xs:positiveInteger" use="required"/>
                  <xs:attribute name="salt" type="xs:base64Binary" use="required"/>
                  <xs:attribute name="hash" type="xs:base64Binary" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="ca2:UserId" use="required"/>
            <xs:attribute name="username" type="ca2:Username" use="required"/>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="email" type="xs:string"/>
            <xs:attribute name="role" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="admin"/><xs:enumeration value="editor"/><xs:enumeration value="player"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="method" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="password"/><xs:enumeration value="authelia"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="enabled" type="xs:boolean" use="required"/>
            <xs:attribute name="created" type="xs:dateTime" use="required"/>
            <xs:attribute name="lastLogin" type="xs:dateTime"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
    <xs:unique name="oneId"><xs:selector xpath="user"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="oneUsername"><xs:selector xpath="user"/><xs:field xpath="@username"/></xs:unique>
  </xs:element>

  <xs:element name="sessions">
    <xs:complexType>
      <xs:sequence>
        <!-- hash: SHA-256 of the cookie's token (the token itself is never stored) -->
        <xs:element name="session" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="hash" type="ca2:Sha256" use="required"/>
            <xs:attribute name="user" type="ca2:UserId" use="required"/>
            <xs:attribute name="created" type="xs:dateTime" use="required"/>
            <xs:attribute name="seen" type="xs:dateTime" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="reset">
    <xs:complexType>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
      <xs:attribute name="user" type="ca2:Username" use="required"/>
      <xs:attribute name="hash" type="ca2:Sha256" use="required"/>
      <xs:attribute name="expires" type="xs:dateTime" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
