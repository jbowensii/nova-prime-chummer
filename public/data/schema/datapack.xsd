<?xml version="1.0" encoding="UTF-8"?>
<!-- datapack.xml: the manifest at the root of a data pack zip (importer/datapack.py). app: the app version that wrote it;
     one <file> per core/<name> in the zip, with its size and SHA-256. A pack holds only the core files. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="datapack">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="file" minOccurs="1" maxOccurs="12">
          <xs:complexType>
            <xs:attribute name="name" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:pattern value="(ampeffects|amptypes|armor|attributes|levels|lifestyles|metatypes|packages|pricing|skills|vehicles|weapons)\.xml"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="bytes" type="xs:nonNegativeInteger" use="required"/>
            <xs:attribute name="sha256" use="required">
              <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[0-9a-f]{64}"/></xs:restriction></xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="format" type="xs:string" fixed="1" use="required"/>
      <xs:attribute name="app" type="xs:string" use="required"/>
      <xs:attribute name="created" type="xs:dateTime" use="required"/>
    </xs:complexType>
    <xs:unique name="one-file-per-name">
      <xs:selector xpath="file"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>
</xs:schema>
