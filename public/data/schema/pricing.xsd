<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for kind="pricing". See docs/data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:data:1"
           targetNamespace="urn:chummer-anarchy2:data:1"
           elementFormDefault="unqualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="data">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="pricing" type="ca2:Pricing"/>
        <!-- a book's partial pricing overlay: only the prices it sets, written over the pricing loaded before it -->
        <xs:element name="prices" type="ca2:Prices"/>
        <xs:element name="remove" type="ca2:Remove"/>
      </xs:choice>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="pricing"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="ca2:root"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Pricing">
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="attrPoint" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="attrLastPoint" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="skillLow" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="skillLowMax" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="skillHigh" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="spec" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="knowledge" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="ampPoint" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="equipment" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="weaponStandard" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="weaponSpecialist" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="armorPoint" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="spell" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="complexForm" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="refundEffectRemoval" type="xs:boolean" use="required"/>
  </xs:complexType>
  <xs:complexType name="Prices">
    <xs:attributeGroup ref="ca2:ref"/>
    <xs:attribute name="attrPoint" type="xs:nonNegativeInteger"/>
    <xs:attribute name="attrLastPoint" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillLow" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillLowMax" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillHigh" type="xs:nonNegativeInteger"/>
    <xs:attribute name="spec" type="xs:nonNegativeInteger"/>
    <xs:attribute name="knowledge" type="xs:nonNegativeInteger"/>
    <xs:attribute name="ampPoint" type="xs:nonNegativeInteger"/>
    <xs:attribute name="equipment" type="xs:nonNegativeInteger"/>
    <xs:attribute name="weaponStandard" type="xs:nonNegativeInteger"/>
    <xs:attribute name="weaponSpecialist" type="xs:nonNegativeInteger"/>
    <xs:attribute name="armorPoint" type="xs:nonNegativeInteger"/>
    <xs:attribute name="spell" type="xs:nonNegativeInteger"/>
    <xs:attribute name="complexForm" type="xs:nonNegativeInteger"/>
    <xs:attribute name="refundEffectRemoval" type="xs:boolean"/>
  </xs:complexType>
</xs:schema>
