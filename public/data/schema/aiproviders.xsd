<?xml version="1.0" encoding="UTF-8"?>
<!-- library/.config/ai-providers.xml: AI provider choices (keys live in ai-keys.xml). use = the provider asked. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:config:1"
           targetNamespace="urn:chummer-anarchy2:config:1"
           elementFormDefault="unqualified">
  <xs:simpleType name="Provider">
    <xs:restriction base="xs:string">
      <xs:enumeration value="anthropic"/><xs:enumeration value="openai"/>
      <xs:enumeration value="gemini"/><xs:enumeration value="anythingllm"/>
      <xs:enumeration value="ollama"/><xs:enumeration value="lmstudio"/><xs:enumeration value="compatible"/>
      <xs:enumeration value="openrouter"/><xs:enumeration value="mistral"/><xs:enumeration value="azure"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="aiproviders">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="provider" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="ca2:Provider" use="required"/>
            <xs:attribute name="enabled" type="xs:boolean" use="required"/>
            <xs:attribute name="baseUrl" type="xs:anyURI"/>
            <xs:attribute name="model" type="xs:string"/>
            <xs:attribute name="workspace" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
      <xs:attribute name="use" type="ca2:Provider"/>
    </xs:complexType>
    <xs:unique name="oneBlockPerProvider"><xs:selector xpath="provider"/><xs:field xpath="@id"/></xs:unique>
  </xs:element>
</xs:schema>
