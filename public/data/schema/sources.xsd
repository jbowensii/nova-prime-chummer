<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for kind="sources". See docs/data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ca2="urn:chummer-anarchy2:data:1"
           targetNamespace="urn:chummer-anarchy2:data:1"
           elementFormDefault="unqualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="data">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="source">
          <xs:complexType>
            <xs:sequence><xs:element name="name" type="xs:string"/></xs:sequence>
            <xs:attribute name="id" use="required">
              <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9][A-Za-z0-9_\-]*"/></xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="publisher" type="xs:string" use="required"/>
            <xs:attribute name="canon" type="xs:boolean" use="required"/>
            <xs:attribute name="texts" type="xs:string"/>
            <!-- imported sources (custom/imported/sources.xml): uploaded file name(s) ("; "-separated),
                 SHA-256(s) (space-separated), and the date of the latest import -->
            <xs:attribute name="file" type="xs:string"/>
            <xs:attribute name="sha256" type="xs:string"/>
            <xs:attribute name="imported" type="xs:date"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="remove" type="ca2:Remove"/>
      </xs:choice>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="sources"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="ca2:root"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
