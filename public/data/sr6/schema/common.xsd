<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared types for every Shadowrun 6 (SR6) data file: the entry types of each kind, so the per-kind schemas and the
     edits layer (edits.xsd) share them. Values are kept as printed, as strings; only counts, points, karma, levels and
     pages are integers. See docs/sr6-data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sr6="urn:chummer-sr6:data:1"
           targetNamespace="urn:chummer-sr6:data:1"
           elementFormDefault="unqualified">

  <xs:simpleType name="Id">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9][a-z0-9.\-]*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SourceId">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z][A-Z0-9\-]{0,19}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="True">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Bool">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/><xs:enumeration value="false"/></xs:restriction>
  </xs:simpleType>
  <!-- the nine core attributes, lower case (metatype ranges); skills add mag and res -->
  <xs:simpleType name="Attr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bod"/><xs:enumeration value="agi"/><xs:enumeration value="rea"/><xs:enumeration value="str"/>
      <xs:enumeration value="wil"/><xs:enumeration value="log"/><xs:enumeration value="int"/><xs:enumeration value="cha"/>
      <xs:enumeration value="edg"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SkillAttr">
    <xs:union memberTypes="sr6:Attr">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mag"/><xs:enumeration value="res"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="Kind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="priorities"/><xs:enumeration value="metatypes"/><xs:enumeration value="attributes"/>
      <xs:enumeration value="skills"/><xs:enumeration value="qualities"/><xs:enumeration value="weapons"/>
      <xs:enumeration value="armor"/><xs:enumeration value="augmentations"/><xs:enumeration value="electronics"/>
      <xs:enumeration value="gear"/><xs:enumeration value="vehicles"/><xs:enumeration value="spells"/>
      <xs:enumeration value="rituals"/><xs:enumeration value="adeptpowers"/><xs:enumeration value="complexforms"/>
      <xs:enumeration value="metamagics"/><xs:enumeration value="echoes"/><xs:enumeration value="critterpowers"/>
      <xs:enumeration value="martialarts"/><xs:enumeration value="martialtechniques"/>
      <xs:enumeration value="critters"/><xs:enumeration value="spirits"/><xs:enumeration value="npcs"/>
      <xs:enumeration value="sprites"/><xs:enumeration value="lifestyles"/><xs:enumeration value="contacts"/>
      <xs:enumeration value="lifemodules"/><xs:enumeration value="rules"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- id + citation carried by every entry (page: the printed page) -->
  <xs:attributeGroup name="ref">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
    <xs:attribute name="source" type="sr6:SourceId" use="required"/>
    <xs:attribute name="page" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- overlay files delete an entry loaded before with <remove id="..."/> -->
  <xs:complexType name="Remove">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
  </xs:complexType>

  <xs:attributeGroup name="version">
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- every entry: <name>, its kind's children, then an optional <text> (empty in imports: the description is in the
       source's texts file) -->
  <xs:group name="tail">
    <xs:sequence><xs:element name="text" type="xs:string" minOccurs="0"/></xs:sequence>
  </xs:group>
  <xs:complexType name="Entry">
    <xs:sequence><xs:element name="name" type="xs:string"/><xs:group ref="sr6:tail"/></xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>
  <xs:complexType name="Points">
    <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="Priority">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="metatype" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="attributes" type="sr6:Points" minOccurs="0"/>
      <xs:element name="skills" type="sr6:Points" minOccurs="0"/>
      <xs:element name="magic" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="full"/><xs:enumeration value="aspected"/><xs:enumeration value="mystic-adept"/>
              <xs:enumeration value="adept"/><xs:enumeration value="technomancer"/><xs:enumeration value="mundane"/>
            </xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="resources" minOccurs="0">
        <xs:complexType><xs:attribute name="nuyen" type="xs:nonNegativeInteger" use="required"/></xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="letter" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-E]"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="Metatype">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="range" minOccurs="0" maxOccurs="9">
        <xs:complexType>
          <xs:attribute name="attr" type="sr6:Attr" use="required"/>
          <xs:attribute name="min" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="max" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- racial qualities, by name as printed (S2 resolves them) -->
      <xs:element name="trait" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>

  <xs:complexType name="Attribute">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="abbr" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="BOD"/><xs:enumeration value="AGI"/><xs:enumeration value="REA"/><xs:enumeration value="STR"/>
          <xs:enumeration value="WIL"/><xs:enumeration value="LOG"/><xs:enumeration value="INT"/><xs:enumeration value="CHA"/>
          <xs:enumeration value="EDG"/><xs:enumeration value="MAG"/><xs:enumeration value="RES"/><xs:enumeration value="ESS"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="group" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="physical"/><xs:enumeration value="mental"/><xs:enumeration value="special"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Skill">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="spec" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attr" type="sr6:SkillAttr" use="required"/>
    <xs:attribute name="untrained" type="sr6:Bool" use="required"/>
  </xs:complexType>

  <xs:complexType name="Quality">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="positive"/><xs:enumeration value="negative"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="karma" type="xs:integer"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Weapon">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="modes" type="xs:string"/>
      <xs:attribute name="ar" type="xs:string"/>
      <xs:attribute name="ammo" type="xs:string"/>
      <!-- the weapon's type as printed (Unarmed, Exotic), an accessory's mount, a grenade's blast -->
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="mount" type="xs:string"/>
      <xs:attribute name="blast" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Armor">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="defense" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Augmentation">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="cyberware"/><xs:enumeration value="bioware"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="essence" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Device">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="array" type="xs:string"/>
      <xs:attribute name="programs" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Gear">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <!-- a focus's bonding cost in Karma, a formula like the cost -->
      <xs:attribute name="karma" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <!-- what the cost buys: "10 rounds", "100m", "month" (none: one item) -->
      <xs:attribute name="per" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Vehicle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="handling" type="xs:string"/>
      <xs:attribute name="accel" type="xs:string"/>
      <xs:attribute name="interval" type="xs:string"/>
      <xs:attribute name="topSpeed" type="xs:string"/>
      <xs:attribute name="body" type="xs:string"/>
      <xs:attribute name="armor" type="xs:string"/>
      <xs:attribute name="pilot" type="xs:string"/>
      <xs:attribute name="sensor" type="xs:string"/>
      <xs:attribute name="seats" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Spell">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="combat"/><xs:enumeration value="detection"/><xs:enumeration value="health"/>
          <xs:enumeration value="illusion"/><xs:enumeration value="manipulation"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="tags" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="damage" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Ritual">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="keywords" type="xs:string"/>
      <xs:attribute name="threshold" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AdeptPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
      <xs:attribute name="activation" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ComplexForm">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="fade" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a martial art style: categories (Weapon, Grappling, …) and its signature technique, as printed -->
  <xs:complexType name="MartialArt">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="categories" type="xs:string"/>
      <xs:attribute name="signature" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MartialTechnique">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CritterPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- critters, spirits and NPCs (grunts): the stat block as printed; the lists are names as printed (S2 resolves them) -->
  <xs:complexType name="Being">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:element name="optionalPowers" type="xs:string" minOccurs="0"/>
      <xs:element name="weaknesses" type="xs:string" minOccurs="0"/>
      <xs:element name="attacks" type="xs:string" minOccurs="0"/>
      <xs:element name="augmentations" type="xs:string" minOccurs="0"/>
      <xs:element name="gear" type="xs:string" minOccurs="0"/>
      <xs:element name="weapons" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="category" type="xs:string"/>
    <!-- npcs: the Professional Rating -->
    <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
    <xs:attribute name="group" type="xs:string"/>
    <xs:attribute name="bod" type="xs:string"/>
    <xs:attribute name="agi" type="xs:string"/>
    <xs:attribute name="rea" type="xs:string"/>
    <xs:attribute name="str" type="xs:string"/>
    <xs:attribute name="wil" type="xs:string"/>
    <xs:attribute name="log" type="xs:string"/>
    <xs:attribute name="int" type="xs:string"/>
    <xs:attribute name="cha" type="xs:string"/>
    <xs:attribute name="ess" type="xs:string"/>
    <xs:attribute name="mag" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
    <xs:attribute name="edg" type="xs:string"/>
    <xs:attribute name="dr" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="actions" type="xs:string"/>
    <xs:attribute name="cm" type="xs:string"/>
    <xs:attribute name="move" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Sprite">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attack" type="xs:string"/>
    <xs:attribute name="sleaze" type="xs:string"/>
    <xs:attribute name="data" type="xs:string"/>
    <xs:attribute name="firewall" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Lifestyle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <!-- per month -->
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Contact">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="connection" type="xs:string"/>
      <xs:attribute name="loyalty" type="xs:string"/>
      <xs:attribute name="archetype" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a life module (lifepath creation): what it grants, as numbers; a mixed choice lists its options as tokens: an
       attribute (bod … res), skill:<skill id> or nuyen:<amount>. No prose. -->
  <xs:simpleType name="ChoiceOption">
    <xs:restriction base="xs:token">
      <xs:pattern value="bod|agi|rea|str|wil|log|int|cha|edg|mag|res|skill:[a-z0-9][a-z0-9.\-]*|nuyen:[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ChoiceOptions">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ChoiceOption"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <!-- the Sixth World Companion's contact types (a life module's, a runner's contact's) -->
  <xs:simpleType name="ContactType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="academic"/><xs:enumeration value="corporate"/><xs:enumeration value="criminal"/>
      <xs:enumeration value="engineering"/><xs:enumeration value="government"/><xs:enumeration value="magic"/>
      <xs:enumeration value="matrix"/><xs:enumeration value="media"/><xs:enumeration value="medical"/><xs:enumeration value="street"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ContactTypes">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ContactType"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="LifeModule">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="choice" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mixed"/></xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="points" type="xs:positiveInteger"/>
          <xs:attribute name="options" type="sr6:ChoiceOptions" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="stage" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="opening"/><xs:enumeration value="adult"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="requires">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="awakened"/><xs:enumeration value="emerged"/><xs:enumeration value="adept"/><xs:enumeration value="magician"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="attributePoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="adjustmentPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="nuyen" type="xs:nonNegativeInteger"/>
    <xs:attribute name="contactPoints" type="xs:nonNegativeInteger"/>
    <!-- the contact types its contact points buy or raise (absent: any type) -->
    <xs:attribute name="contactTypes" type="sr6:ContactTypes"/>
    <xs:attribute name="knowledgeSkills" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- a rule section: <name> is its title; level 1 = chapter section … 4; parent = the enclosing section's id -->
  <xs:complexType name="Rule">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="chapter" type="xs:string" use="required"/>
      <xs:attribute name="level" use="required">
        <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="parent" type="sr6:Id"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
</xs:schema>
