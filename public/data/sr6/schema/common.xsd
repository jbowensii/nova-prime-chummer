<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared types for every Shadowrun 6 (SR6) data file: the entry types of each kind, so the per-kind schemas and the
     edits layer (edits.xsd) share them. Values are kept as printed, as strings; only counts, points, karma, levels and
     pages are integers. See docs/sr6-data-format/kinds.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sr6="urn:chummer-sr6:data:1"
           targetNamespace="urn:chummer-sr6:data:1"
           elementFormDefault="unqualified">

  <xs:simpleType name="Id">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9][a-z0-9.\-]*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SourceId">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z][A-Z0-9\-]{0,19}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="True">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Bool">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/><xs:enumeration value="false"/></xs:restriction>
  </xs:simpleType>
  <!-- the nine core attributes, lower case (metatype ranges); skills add mag and res -->
  <xs:simpleType name="Attr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bod"/><xs:enumeration value="agi"/><xs:enumeration value="rea"/><xs:enumeration value="str"/>
      <xs:enumeration value="wil"/><xs:enumeration value="log"/><xs:enumeration value="int"/><xs:enumeration value="cha"/>
      <xs:enumeration value="edg"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SkillAttr">
    <xs:union memberTypes="sr6:Attr">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mag"/><xs:enumeration value="res"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="Kind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="priorities"/><xs:enumeration value="metatypes"/><xs:enumeration value="attributes"/>
      <xs:enumeration value="skills"/><xs:enumeration value="qualities"/><xs:enumeration value="weapons"/>
      <xs:enumeration value="armor"/><xs:enumeration value="augmentations"/><xs:enumeration value="grades"/>
      <xs:enumeration value="electronics"/><xs:enumeration value="programs"/>
      <xs:enumeration value="gear"/><xs:enumeration value="vehicles"/><xs:enumeration value="spells"/>
      <xs:enumeration value="rituals"/><xs:enumeration value="adeptpowers"/><xs:enumeration value="complexforms"/>
      <xs:enumeration value="metamagics"/><xs:enumeration value="echoes"/><xs:enumeration value="critterpowers"/>
      <xs:enumeration value="martialarts"/><xs:enumeration value="martialtechniques"/>
      <xs:enumeration value="traditions"/>
      <xs:enumeration value="critters"/><xs:enumeration value="spirits"/><xs:enumeration value="npcs"/>
      <xs:enumeration value="sprites"/><xs:enumeration value="lifestyles"/><xs:enumeration value="contacts"/>
      <xs:enumeration value="lifemodules"/>
      <xs:enumeration value="actions"/>
      <xs:enumeration value="packs"/>
      <xs:enumeration value="vehicledesign"/>
      <xs:enumeration value="ammotypes"/>
      <xs:enumeration value="mentorspirits"/>
      <xs:enumeration value="datastructures"/>
      <xs:enumeration value="qualitypaths"/>
      <xs:enumeration value="spellfeatures"/>
      <xs:enumeration value="contacttypes"/>
      <xs:enumeration value="qualitysets"/>
      <xs:enumeration value="licencetypes"/>
      <xs:enumeration value="magictypes"/>
      <xs:enumeration value="ruleoptions"/>
      <xs:enumeration value="senses"/>
      <xs:enumeration value="trueelements"/>
      <xs:enumeration value="categories"/>
      <xs:enumeration value="rules"/>
      <!-- (a texts file's of= only: a book sample runner's correction in the edits layer, its description) -->
      <xs:enumeration value="samplefixes"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- id + citation carried by every entry (page: the printed page) -->
  <xs:attributeGroup name="ref">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
    <xs:attribute name="source" type="sr6:SourceId" use="required"/>
    <xs:attribute name="page" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- overlay files delete an entry loaded before with <remove id="..."/> -->
  <xs:complexType name="Remove">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
  </xs:complexType>

  <xs:attributeGroup name="version">
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- every entry: <name>, its kind's children, its <formula>s and <issue>s, then an optional <text> (empty in imports:
       the description is in the source's texts file) -->
  <xs:group name="tail">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="formula" type="sr6:Formula"/>
        <xs:element name="issue" type="sr6:Issue"/>
        <xs:element name="found" type="sr6:Found"/>
        <!-- another name the book prints the item under (a table row's shorter name, its description heading's); or,
             with id (and kind, when it was another), an id the entry had in an earlier import: the app resolves the
             old id to this entry and turns a saved runner's old id into this one -->
        <xs:element name="alias" type="sr6:Alias"/>
        <!-- a cell's footnote: the note its footnote mark points to, for that field (the mark is left out of the value) -->
        <xs:element name="note" type="sr6:Note"/>
        <!-- what the entry's prose states it does (importer/sr6/effects.py, below): a quality's, or an accessory's to the
             item it fits (target item:<field>) -->
        <xs:element name="effect" type="sr6:Effect"/>
        <xs:element name="test" type="sr6:Test"/>
        <xs:element name="link" type="sr6:Link"/>
        <!-- a choice the entry offers (sr6:Choice): a quality's granted picks, a life module's mixed points, a power's
             sense or skill, a focus option, a fake licence's type -->
        <xs:element name="choice" type="sr6:Choice"/>
        <!-- a prerequisite the entry's text prints (a martial arts technique's, importer/sr6/flags.py requires): the
             name as printed, its kind adeptpower, technique, quality, augmentation or other -->
        <xs:element name="requires" type="sr6:Requires"/>
        <!-- what the entry can't be combined with (importer/sr6/effects.py incompatibilities; CRB Hong Kong pp. 157,
             286-293): targets, the attributes and initiative an augmentation that raises them can't go with
             (`attr:rea derived:initiative-dice`); names, the entries named (`; `-separated, `wired reflexes`); family, a
             name only one entry starting with may be installed (`Bone Lacing`). And a wireless exception: <compatible
             name switch="wireless"/> -->
        <xs:element name="incompatible" type="sr6:Incompatible"/>
        <xs:element name="compatible" type="sr6:Compatible"/>
        <!-- Commlink6's structure for an item (docs/sr6-data-format/item-structure.md, Item structure): a slot the item offers (id; value:
             how many, a formula like the cost), a slot it fits, the variants it comes in (by name), the topics it is
             relevant to (a pick list's filters), and kind flags. Data for the pickers and the Foundry export; no rule reads
             them yet -->
        <xs:element name="slot" type="sr6:Slot"/>
        <xs:element name="fits" type="sr6:Fits"/>
        <xs:element name="variant" type="sr6:Variant"/>
        <xs:element name="relevance" type="sr6:Relevance"/>
        <xs:element name="flag" type="xs:string"/>
        <!-- Commlink6's own rule data for the item, kept as it gives it and never applied: a modification it makes
             (kind valmod, checkmod, itemmod or allowmod, with its type, ref, value and conditions), a prerequisite
             (kind datareq or valuereq) and a pick it offers (type, ref, options). The app reads our <effect>s, <link>s,
             <requires> and <choice>s; these are the reference those are measured against -->
        <xs:element name="modifier" type="sr6:Cl6Data"/>
        <xs:element name="prerequisite" type="sr6:Cl6Data"/>
        <xs:element name="selection" type="sr6:Cl6Data"/>
        <!-- a status the entry applies (CRB p. 51's statuses: a weapon's `Burning 4`, the No Future errata's Molotov), by
             the status's name and its level when it has one; shown with the item, never applied to the runner -->
        <xs:element name="status" type="sr6:Status"/>
        <!-- a modification a vehicle comes with, already paid for (Double Clutch p. 146's box on the core rulebook's
             vehicles: importer/sr6/resolve.py _builtin_mods): its name as printed, the modification's id (ref) when it
             resolves, its rating, or extra mod slots of a category; source and page: the box's. A part of the box that is
             a sentence is a <note field="builtin"> -->
        <xs:element name="builtin" type="sr6:Builtin"/>
      </xs:choice>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="Builtin">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="ref" type="sr6:Id"/>
    <xs:attribute name="rating" type="xs:string"/>
    <xs:attribute name="slots" type="xs:string"/>
    <xs:attribute name="category" type="xs:string"/>
    <xs:attribute name="source" type="sr6:SourceId"/>
    <xs:attribute name="page" type="xs:positiveInteger"/>
  </xs:complexType>
  <xs:complexType name="Note">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a table row's place in its category (importer/sr6/categories.py): group, the category's name when the row's own
       name needs it (a bare part: the app shows "Cyberlimb: Arm (synthetic)"); maker, the maker its product's title
       prints ("Cougar Weapons") -->
  <xs:attributeGroup name="grouped">
    <xs:attribute name="group" type="xs:string"/>
    <xs:attribute name="maker" type="xs:string"/>
    <!-- a configuration of another entry (its id): a shape that item takes, its own stats printed, never bought apart
         (the Dassault Alpenstock's spear configuration) -->
    <xs:attribute name="configOf" type="xs:string"/>
    <!-- an accessory priced as an add-on to other entries (their ids: the Colt Agent Special's laser sight, a knife or
         spike head for both tactical hammers), or a supply for one (a weapon's batteries) -->
    <xs:attribute name="accessoryOf" type="xs:string"/>
    <xs:attribute name="supplyOf" type="xs:string"/>
    <!-- bought only as an add-on to another item (Commlink6's modonly), a weapon's size class and the ammunition class it
         draws on -->
    <xs:attribute name="modonly" type="xs:boolean"/>
    <xs:attribute name="size" type="xs:string"/>
    <xs:attribute name="ammoClass" type="xs:string"/>
  </xs:attributeGroup>
  <!-- Commlink6's own classification of the entry, verbatim: its TYPE/SUBTYPE keys (`ARMOR/ARMOR_BODY`, `SOFTWARE/AUTOSOFT`),
       its TYPE alone, or the record's tag for a kind with no type (`spell`, `ammotype`). Set from the category (importer/sr6/
       classes/category_class.json) or per item (importer/sr6/overrides); a category's own class is every entry's of it. -->
  <xs:simpleType name="ClassKey">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_]+(/[A-Za-z0-9_]+)?"/></xs:restriction>
  </xs:simpleType>
  <!-- one category of a book's table rows (categories.xml): its name (the table's title, singular), the kind its rows
       are (of), the printed table and section titles, and how they link: an accessory category's hosts (fits) and a
       host's accessory categories (accessories), names separated by "; ". confidence="low" with why: the name came
       from the section heading (no title, a title naming no category, a title split across lines). -->
  <xs:complexType name="Category">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="of" type="sr6:Kind" use="required"/>
      <xs:attribute name="table" type="xs:string"/>
      <xs:attribute name="section" type="xs:string"/>
      <xs:attribute name="confidence"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="low"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="why" type="xs:string"/>
      <xs:attribute name="fits" type="xs:string"/>
      <xs:attribute name="accessories" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Incompatible">
    <xs:attribute name="targets" type="xs:string"/>
    <xs:attribute name="names" type="xs:string"/>
    <xs:attribute name="family" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="Cl6Data">
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="Status">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="level" type="xs:positiveInteger"/>
  </xs:complexType>
  <xs:complexType name="Slot">
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="Fits">
    <xs:attribute name="slot" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="Variant">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="Relevance">
    <xs:attribute name="topic" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="Compatible">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="switch"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="wireless"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="Requires">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="adeptpower"/><xs:enumeration value="technique"/><xs:enumeration value="quality"/>
          <xs:enumeration value="augmentation"/><xs:enumeration value="other"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Alias">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="id" type="xs:string"/>
      <xs:attribute name="kind" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- how a field is worked out (src/shared/formula.ts): R rating, Q quantity, M Magic, B the field's printed value,
       opt.<id>; tier(), ref(kind:id, field[, R]), ceil, floor, min, max, + - * /. The attribute stays as printed.
       unit and qty: the price is for qty units ("10" "rounds"). round: up (the default) or down. -->
  <xs:simpleType name="Field">
    <xs:restriction base="xs:string"><xs:pattern value="[a-zA-Z][a-zA-Z0-9]*"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Formula">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="round"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="up"/><xs:enumeration value="down"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="unit" type="xs:string"/>
      <xs:attribute name="qty" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a field the book prints nothing for (missing), or that the importer couldn't read (unreadable, ambiguous): the
       app flags the entry until an edit or an override file sets it; page: where the book has the entry; the text: a short note -->
  <xs:complexType name="Issue">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="code" use="required"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="missing"/><xs:enumeration value="unreadable"/><xs:enumeration value="ambiguous"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="page" type="xs:positiveInteger"/>
      <!-- where the importer looked before writing it (importer/sr6/resolve.py): the book (its tables and text), and
           the corpus (every other source of the library) -->
      <xs:attribute name="searched"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="book"/><xs:enumeration value="book,corpus"/></xs:restriction></xs:simpleType></xs:attribute>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a value the entry's own row leaves out (or prints unreadably), found elsewhere (importer/sr6/resolve.py): another
       table or a sentence of the same book (how="table", "text"), another source of the library (how="corpus"), or an
       errata newer than the book (how="errata": the text is the value it replaced); source and page: where it is printed -->
  <xs:complexType name="Found">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="how" use="required"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="table"/><xs:enumeration value="text"/><xs:enumeration value="corpus"/>
        <xs:enumeration value="errata"/><xs:enumeration value="printing"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="source" type="sr6:SourceId"/>
      <xs:attribute name="page" type="xs:positiveInteger"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Entry">
    <xs:sequence><xs:element name="name" type="xs:string"/><xs:group ref="sr6:tail"/></xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>
  <xs:complexType name="Points">
    <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="Priority">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="metatype" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="attributes" type="sr6:Points" minOccurs="0"/>
      <xs:element name="skills" type="sr6:Points" minOccurs="0"/>
      <xs:element name="magic" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="full"/><xs:enumeration value="aspected"/><xs:enumeration value="mystic-adept"/>
              <xs:enumeration value="adept"/><xs:enumeration value="technomancer"/><xs:enumeration value="mundane"/>
            </xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="resources" minOccurs="0">
        <xs:complexType><xs:attribute name="nuyen" type="xs:nonNegativeInteger" use="required"/></xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="letter" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-E]"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="Metatype">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="range" minOccurs="0" maxOccurs="9">
        <xs:complexType>
          <xs:attribute name="attr" type="sr6:Attr" use="required"/>
          <xs:attribute name="min" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="max" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- racial qualities, by name as printed (S2 resolves them) -->
      <xs:element name="trait" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <!-- a metavariant's adjustment points at each metatype priority it can be taken at (the Sixth World Companion's
           development table): priority creation offers it at those letters, the priority table not listing it -->
      <xs:element name="priority" minOccurs="0" maxOccurs="5">
        <xs:complexType>
          <xs:attribute name="letter" use="required">
            <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-E]"/></xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>

  <xs:complexType name="Attribute">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="abbr" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="BOD"/><xs:enumeration value="AGI"/><xs:enumeration value="REA"/><xs:enumeration value="STR"/>
          <xs:enumeration value="WIL"/><xs:enumeration value="LOG"/><xs:enumeration value="INT"/><xs:enumeration value="CHA"/>
          <xs:enumeration value="EDG"/><xs:enumeration value="MAG"/><xs:enumeration value="RES"/><xs:enumeration value="ESS"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="group" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="physical"/><xs:enumeration value="mental"/><xs:enumeration value="special"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Skill">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="spec" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attr" type="sr6:SkillAttr" use="required"/>
    <xs:attribute name="untrained" type="sr6:Bool" use="required"/>
  </xs:complexType>

  <!-- an entry's effects (importer/sr6/effects.py, docs/sr6-data-format/kinds.md "Effects"): what its prose or the book's
       tables state, as a target (attr:<abbr>, attr-max:<abbr>, skill:<id>, test:<type>, derived:<name>, matrix:<name>,
       item:<field> (on an add-on: the item it fits; `item:ar` a value a band "0,1,1,0,0"), action:<name>,
       resource:<name>), an operation and a value (a number; R: x the line's rating or level; R*N; or a formula over
       attributes, shown only). confidence="low": read from a sentence that sets a condition, shown and never applied;
       switch: how it is turned on; when: the condition's words (`magician`, `climbing`, `in VR`). A test the entry
       calls for: skill + attribute (threshold). -->
  <xs:complexType name="Effect">
    <xs:attribute name="target" type="xs:string" use="required"/>
    <!-- add (+N/-N); set (the value replaces it: an attribute maximum); edge (N bonus Edge on those tests); edge-cost
         (Edge boosts and actions on them cost N more, -N less); edge-cost-set (an Edge action's new cost); no-edge (no
         Edge may be spent on them); no-edge-gain (none gained); wild-die (one die a wild die); hits (N extra hits);
         threshold (the tests' threshold moves by N: a toxin extractor's -R); threshold-set (their new threshold: spider eyes' 2) -->
    <xs:attribute name="op" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="add"/><xs:enumeration value="set"/><xs:enumeration value="edge"/>
      <xs:enumeration value="edge-cost"/><xs:enumeration value="edge-cost-set"/><xs:enumeration value="no-edge"/>
      <xs:enumeration value="no-edge-gain"/><xs:enumeration value="wild-die"/><xs:enumeration value="hits"/>
      <xs:enumeration value="threshold"/><xs:enumeration value="threshold-set"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <!-- low: read from a sentence the importer isn't sure of (a condition with no words, a formula per point of
         something): shown, never applied -->
    <xs:attribute name="confidence"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="low"/></xs:restriction></xs:simpleType></xs:attribute>
    <!-- how it is turned on (none: always on, in the total shown first): a wireless bonus, activated (at will, an
         action, overdrive), sustained, or on some tests or situations only; a switchable one counts in the bracketed
         total, `6 (9)` (owner decision 2026-10-10) -->
    <xs:attribute name="switch"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="wireless"/><xs:enumeration value="activated"/><xs:enumeration value="sustained"/>
      <xs:enumeration value="conditional"/></xs:restriction></xs:simpleType></xs:attribute>
    <!-- the condition's words (`while in the Matrix`) or a test the book names by activity (`escaping bonds`) -->
    <xs:attribute name="when" type="xs:string"/>
    <!-- the specialization a skill effect is limited to (`Climbing`): added to that specialization's pool when the
         runner has it, else to the skill's bracketed total (owner decision 2026-10-10) -->
    <xs:attribute name="spec" type="xs:string"/>
    <!-- a spell's, ritual's or complex form's: whom it affects (owner decision 2026-10-10); caster: counted on the
         caster while sustained; target: never on the caster; others: what others get against the entry, never counted
         on the runner (owner decision #16) -->
    <xs:attribute name="affects"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="caster"/><xs:enumeration value="target"/><xs:enumeration value="others"/></xs:restriction></xs:simpleType></xs:attribute>
    <!-- the id of the linked entry whose effect the importer copied here (effects.py copy_links; owner direction
         2026-10-17: every entry holds the effects of its whole object); the book's own word for the entry is without it -->
    <xs:attribute name="from" type="xs:string"/>
    <!-- the heading of the rule the book states for all the items of a class (a section's intro, a variant's table row):
         the importer gives it to the entries of the same class in other books, each `from` "<source>:<heading>"
         (import bookkeeping) -->
    <xs:attribute name="rule" type="xs:string"/>
    <!-- book: the effect is a hand-written correction of what the book's text says that no reader rule expresses (the same file, "gen": "book") -->
    <!-- cl6: the effect is a hand-written Commlink6 override (importer/sr6/overrides/<book>.json, "gen": "cl6"), not the book
         reader's: shown as such, a rare exception to the owner's rule that our reader is the primary source -->
    <xs:attribute name="gen"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="cl6"/><xs:enumeration value="book"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <!-- another entry this one grants (rel grants: `gain the Built Tough quality`, `1 free level of Rapid Healing`, at
       `level`) or works as (rel as: `the same result as a Personalized Grip`): the app uses that entry's effects, so a
       later correction follows (owner decision 2026-10-10). name as printed; kind and ref (its id) when the book tells;
       when: a mentor spirit's role. A variant priced from its base item (`Transgenic gills`, "than the base item") works
       as that item. -->
  <xs:complexType name="Link">
    <xs:attribute name="rel" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="grants"/><xs:enumeration value="as"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="kind" type="sr6:Kind"/>
    <xs:attribute name="ref" type="sr6:Id"/>
    <xs:attribute name="level" type="xs:positiveInteger"/>
    <xs:attribute name="when" type="xs:string"/>
    <!-- yes: the importer copied that entry's effects into this one (each `from` its id): not followed again -->
    <xs:attribute name="copied"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="yes"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="Test">
    <xs:attribute name="skill" type="xs:string" use="required"/>
    <xs:attribute name="attr" type="xs:string" use="required"/>
    <xs:attribute name="threshold" type="xs:nonNegativeInteger"/>
  </xs:complexType>
  <!-- a choice: kind quality (count picks from the catalog's qualities of `category`, max the most the list allows);
       mixed (a life module's: `points` to one of `options`, tokens an attribute bod … res, skill:<id> or nuyen:<n>);
       skill (one of `from`, names separated by "; ", or any), specialization (in the chosen skill, or in `category`),
       knowledgeskill; sense, trueelement, licencetype (one entry of that kind, of `category` when given). free: the
       label of a value the player may write instead (`other (L) item`). -->
  <xs:complexType name="Choice">
    <xs:attribute name="kind" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="quality"/><xs:enumeration value="mixed"/><xs:enumeration value="skill"/>
      <xs:enumeration value="specialization"/><xs:enumeration value="knowledgeskill"/><xs:enumeration value="sense"/>
      <xs:enumeration value="trueelement"/><xs:enumeration value="licencetype"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="category" type="xs:string"/>
    <xs:attribute name="count" type="xs:positiveInteger"/>
    <xs:attribute name="max" type="xs:positiveInteger"/>
    <xs:attribute name="points" type="xs:positiveInteger"/>
    <xs:attribute name="options" type="sr6:ChoiceOptions"/>
    <xs:attribute name="from" type="xs:string"/>
    <xs:attribute name="free" type="xs:string"/>
  </xs:complexType>
  <!-- a correction of a book sample runner's printed line (the edits layer only: the owner's override file), id: the
       sample's id (crb.face), source and page: its stat block's. Each <correct> sets one field of the line whose catalog
       item it names, while the runner's line still has the printed value (from); note: why (an owner's correction).
       The runner file keeps the book's value; the app reads the corrected one and Review notes it. -->
  <xs:complexType name="SampleFix">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="correct" maxOccurs="50">
        <xs:complexType>
          <xs:attribute name="item" type="xs:string" use="required"/>
          <xs:attribute name="field" use="required">
            <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="rating"/><xs:enumeration value="qty"/><xs:enumeration value="grade"/></xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="from" type="xs:string" use="required"/>
          <xs:attribute name="to" type="xs:string" use="required"/>
          <xs:attribute name="note" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>

  <xs:complexType name="Quality">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <!-- an Infected quality's rules (Sixth World Companion pp. 104-114, docs/sr6-data-format/kinds.md, Infected characters):
           <infected> its strain and base metatype; <infectedalt> its terms for another base metatype (the non-human
           vampire); <optionalpower> an optional power it may buy (ref: the optional power's quality id; free: one its free
           pick may take); <power> and <weakness> what it gains (sr6:Gained); <karmaif> its Karma when a character flag holds
           (flag awakened: Mutaqua, Astral Hazing) -->
      <xs:element name="infected" type="sr6:Infected" minOccurs="0"/>
      <xs:element name="infectedalt" type="sr6:InfectedAlt" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="optionalpower" type="sr6:OptionalPower" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="power" type="sr6:Gained" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="weakness" type="sr6:Gained" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="karmaif" type="sr6:KarmaIf" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>  <!-- (its choices, effects and tests: the tail's) -->
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="positive"/><xs:enumeration value="negative"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <!-- karma: the lowest price printed, karmaMax: the highest when it prints a range or several (Phobia: by rarity) -->
      <xs:attribute name="karma" type="xs:integer"/>
      <xs:attribute name="karmaMax" type="xs:integer"/>
      <!-- the prices it is bought at when its price line lists them (`7 or 12 Karma`: "7 12"), never a value between -->
      <xs:attribute name="karmaSteps" type="xs:string"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
      <!-- the list it is printed in (`Returned Soldier power`); granted: never bought on its own, only granted (by a
           quality's choice: Karma 0) -->
      <xs:attribute name="category" type="xs:string"/>
      <xs:attribute name="granted" type="sr6:True"/>
      <!-- uncounted: not one of the six qualities a runner may take at creation (its text says so: Lofwyr's Legions' drake
           qualities) -->
      <xs:attribute name="uncounted" type="sr6:True"/>
      <!-- the quality path a bare step heading belongs to (`Step 2` under `Quality Path: Gestalt`): the app shows
           "Gestalt: Step 2" -->
      <xs:attribute name="group" type="xs:string"/>
      <!-- an Infected quality (Commlink6's type INFECTED) or an Infected optional power (INFECTED/OPTIONAL_POWER, ours):
           offered only while the table's infectedAllowed rule is on (classes/section_prefix.json) -->
      <xs:attribute name="class" type="sr6:ClassKey"/>
  </xs:complexType>
  <!-- strain: I, II or III (Ia is I: printed="Ia"); base: the base metatype as the attributes table prints it (Human,
       Sasquatch); awakens: what a character not yet Awakened Awakens as (adept, magician); freePhysical, freeMental: the
       free attribute points; essence, magic, magicLoss: Strain II/III's Essence, the Magic a mundane gains, the Magic one
       already Awakened loses; magicMax: a formula over ess and initiate-grade -->
  <xs:complexType name="Infected">
    <xs:attribute name="strain" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="I"/><xs:enumeration value="II"/><xs:enumeration value="III"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="printed" type="xs:string"/>
    <xs:attribute name="base" type="xs:string" use="required"/>
    <xs:attribute name="awakens">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="adept"/><xs:enumeration value="magician"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="freePhysical" type="xs:nonNegativeInteger"/>
    <xs:attribute name="freeMental" type="xs:nonNegativeInteger"/>
    <xs:attribute name="essence" type="xs:nonNegativeInteger"/>
    <xs:attribute name="magic" type="xs:nonNegativeInteger"/>
    <xs:attribute name="magicLoss" type="xs:nonNegativeInteger"/>
    <xs:attribute name="magicMax" type="xs:string"/>
  </xs:complexType>
  <!-- base other: any base metatype but the type's own; karma: its price there; bod … cha: added to that metatype's
       own maxima; page: the sidebar's; note: shown with the price -->
  <xs:complexType name="InfectedAlt">
    <xs:attribute name="base" type="xs:string" use="required"/>
    <xs:attribute name="karma" type="xs:integer" use="required"/>
    <xs:attribute name="bod" type="xs:integer"/>
    <xs:attribute name="agi" type="xs:integer"/>
    <xs:attribute name="rea" type="xs:integer"/>
    <xs:attribute name="str" type="xs:integer"/>
    <xs:attribute name="wil" type="xs:integer"/>
    <xs:attribute name="log" type="xs:integer"/>
    <xs:attribute name="int" type="xs:integer"/>
    <xs:attribute name="cha" type="xs:integer"/>
    <xs:attribute name="page" type="xs:positiveInteger"/>
    <xs:attribute name="note" type="xs:string"/>
  </xs:complexType>
  <!-- a power or weakness an Infected type gains (its `Gained Powers:` and `Gained Weaknesses:` items): name as printed
       less page citations (`Natural Weapon (Claws, Bite)`), rating (`Armor 1`, `Armor (4)`), ref the critter power's id
       when the same book prints it; else the app finds it by name across the catalog (a power: critter powers, then
       qualities; a weakness: the critter weaknesses, rules entries) and lists one it can't find, never guessed. Free -->
  <xs:complexType name="Gained">
    <xs:attribute name="ref" type="sr6:Id"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="rating" type="xs:positiveInteger"/>
  </xs:complexType>
  <xs:complexType name="OptionalPower">
    <xs:attribute name="ref" type="sr6:Id" use="required"/>
    <xs:attribute name="free" type="sr6:True"/>
  </xs:complexType>
  <!-- the quality's Karma (value) when the character flag holds (awakened: a magician, adept, mystic adept or aspected
       magician, not a technomancer); note: the printed price's note, shown with it -->
  <xs:complexType name="KarmaIf">
    <xs:attribute name="flag" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="awakened"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="value" type="xs:integer" use="required"/>
    <xs:attribute name="note" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Weapon">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <!-- the ratings (Size, Level …) a rated weapon or mount comes in, where the book prints them -->
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="modes" type="xs:string"/>
      <xs:attribute name="ar" type="xs:string"/>
      <xs:attribute name="ammo" type="xs:string"/>
      <!-- the weapon's type as printed (Unarmed, Exotic), an accessory's mount, a grenade's blast -->
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="mount" type="xs:string"/>
      <xs:attribute name="blast" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <!-- what the cost buys, for ammunition filed with the weapons: "10 rounds" -->
      <xs:attribute name="per" type="xs:string"/>
      <!-- a close-combat weapon's skill and specialization, from its TYPE (Blade: Close Combat, Blades) -->
      <xs:attribute name="skill" type="xs:string"/>
      <xs:attribute name="spec" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Armor">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="defense" type="xs:string"/>
      <!-- its SOCIAL column as printed (`+2`, `–4`, `—`): what it adds to the wearer's Social Rating (Firing Squad) -->
      <xs:attribute name="social" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Augmentation">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="type" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="cyberware"/><xs:enumeration value="bioware"/><xs:enumeration value="geneware"/><xs:enumeration value="nanoware"/><xs:enumeration value="symbionts"/><xs:enumeration value="transgenics"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="essence" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- an implant grade: its Essence and cost multipliers and Availability modifier (numbers), the augmentation types it
       is for (absent: cyberware and bioware) -->
  <xs:complexType name="Grade">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="essence" type="sr6:Decimal"/>
      <xs:attribute name="cost" type="sr6:Decimal"/>
      <xs:attribute name="avail" type="sr6:Decimal"/>
      <!-- the grade a later book redefines as this one (Body Shop's omega: the core rulebook's used), its key -->
      <xs:attribute name="replaces" type="xs:string"/>
      <xs:attribute name="types">
        <xs:simpleType><xs:list><xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="cyberware"/><xs:enumeration value="bioware"/><xs:enumeration value="geneware"/>
          <xs:enumeration value="nanoware"/><xs:enumeration value="symbionts"/><xs:enumeration value="transgenics"/>
        </xs:restriction></xs:simpleType></xs:list></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="Decimal">
    <xs:restriction base="xs:string"><xs:pattern value="-?[0-9]+(\.[0-9]+)?"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Device">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="array" type="xs:string"/>
      <xs:attribute name="programs" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a Matrix program: its type as printed (basic, hacking, autosoft …); the ratings it comes in, avail and cost only
       where the book prints them -->
  <xs:complexType name="Program">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="modonly" type="xs:boolean"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Gear">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <!-- a focus's bonding cost in Karma, a formula like the cost -->
      <xs:attribute name="karma" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <!-- what the cost buys: "10 rounds", "100m", "month" (none: one item) -->
      <xs:attribute name="per" type="xs:string"/>
      <!-- a vehicle modification's modification slots, a formula like the cost ("1/3 body (rounded up)") -->
      <xs:attribute name="slots" type="xs:string"/>
      <!-- a weapon power supply's Energy (an energy weapon's ammo formula reads it: ref(gear:<id>, energy)) -->
      <xs:attribute name="energy" type="xs:string"/>
      <!-- a rocket or missile's range as printed ("1.5 km") and the Pilot and Sensor ratings of its guidance -->
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="pilot" type="xs:string"/>
      <xs:attribute name="sensor" type="xs:string"/>
      <!-- the hardpoint a vehicle weapon mount, drone rack or mechanical arm attaches to (Double Clutch pp. 142-145) -->
      <xs:attribute name="hardpoint">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="small"/><xs:enumeration value="standard"/><xs:enumeration value="large"/><xs:enumeration value="huge"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Vehicle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="handling" type="xs:string"/>
      <xs:attribute name="accel" type="xs:string"/>
      <xs:attribute name="interval" type="xs:string"/>
      <xs:attribute name="topSpeed" type="xs:string"/>
      <xs:attribute name="body" type="xs:string"/>
      <xs:attribute name="armor" type="xs:string"/>
      <xs:attribute name="pilot" type="xs:string"/>
      <xs:attribute name="sensor" type="xs:string"/>
      <xs:attribute name="seats" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Spell">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="combat"/><xs:enumeration value="detection"/><xs:enumeration value="health"/>
          <xs:enumeration value="illusion"/><xs:enumeration value="manipulation"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="tags" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="damage" type="xs:string"/>
      <!-- opposed: its test is opposed (every Combat spell); essence: its test counts the target's Essence (threshold or resistance) -->
      <xs:attribute name="opposed" type="sr6:True"/>
      <xs:attribute name="essence" type="sr6:True"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Ritual">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="keywords" type="xs:string"/>
      <xs:attribute name="threshold" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AdeptPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="cost" type="xs:string"/>
      <!-- the cost when the skill it is for is a combat skill (Improved Ability: `Combat skill: 1.0 PP per level; other
           skills 0.5 PP per level`, CRB Hong Kong p. 157); cost is the other skills' -->
      <xs:attribute name="costCombat" type="xs:string"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
      <xs:attribute name="activation" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- user: only an adept (or mystic adept) may take it, or only a magician (or mystic adept); absent: any initiate.
       perLevel: it can be taken again (each time one more initiation's metamagic), up to maxLevel times -->
  <xs:complexType name="Metamagic">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="user">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="adept"/><xs:enumeration value="magician"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ComplexForm">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="fade" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a martial art style: categories (Weapon, Grappling, …) and its signature technique, as printed -->
  <xs:complexType name="MartialArt">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="categories" type="xs:string"/>
      <xs:attribute name="signature" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MartialTechnique">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CritterPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
      <!-- the tags printed over the power (Street Wyrd: Free, Great) -->
      <xs:attribute name="tags" type="xs:string"/>
      <!-- a weakness (Fragile, Carrier): the book's stat blocks list it under Weaknesses -->
      <xs:attribute name="weakness" type="sr6:True"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- critters, spirits and NPCs (grunts): the stat block as printed; the lists are names as printed (S2 resolves them) -->
  <xs:complexType name="Being">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:element name="optionalPowers" type="xs:string" minOccurs="0"/>
      <xs:element name="spells" type="xs:string" minOccurs="0"/>
      <xs:element name="weaknesses" type="xs:string" minOccurs="0"/>
      <xs:element name="attacks" type="xs:string" minOccurs="0"/>
      <xs:element name="augmentations" type="xs:string" minOccurs="0"/>
      <xs:element name="gear" type="xs:string" minOccurs="0"/>
      <xs:element name="weapons" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="category" type="xs:string"/>
    <!-- npcs: the Professional Rating -->
    <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
    <xs:attribute name="group" type="xs:string"/>
    <xs:attribute name="bod" type="xs:string"/>
    <xs:attribute name="agi" type="xs:string"/>
    <xs:attribute name="rea" type="xs:string"/>
    <xs:attribute name="str" type="xs:string"/>
    <xs:attribute name="wil" type="xs:string"/>
    <xs:attribute name="log" type="xs:string"/>
    <xs:attribute name="int" type="xs:string"/>
    <xs:attribute name="cha" type="xs:string"/>
    <xs:attribute name="ess" type="xs:string"/>
    <xs:attribute name="mag" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
    <xs:attribute name="edg" type="xs:string"/>
    <xs:attribute name="dr" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="actions" type="xs:string"/>
    <xs:attribute name="cm" type="xs:string"/>
    <xs:attribute name="move" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Sprite">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attack" type="xs:string"/>
    <xs:attribute name="sleaze" type="xs:string"/>
    <xs:attribute name="data" type="xs:string"/>
    <xs:attribute name="firewall" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Lifestyle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <!-- per month -->
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Contact">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="connection" type="xs:string"/>
      <xs:attribute name="loyalty" type="xs:string"/>
      <xs:attribute name="archetype" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a life module (lifepath creation): what it grants, as numbers; a mixed choice lists its options as tokens: an
       attribute (bod … res), skill:<skill id> or nuyen:<amount>. No prose. -->
  <xs:simpleType name="ChoiceOption">
    <xs:restriction base="xs:token">
      <xs:pattern value="bod|agi|rea|str|wil|log|int|cha|edg|mag|res|skill:[a-z0-9][a-z0-9.\-]*|nuyen:[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ChoiceOptions">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ChoiceOption"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <!-- the Sixth World Companion's contact types (a life module's, a runner's contact's) -->
  <xs:simpleType name="ContactType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="academic"/><xs:enumeration value="corporate"/><xs:enumeration value="criminal"/>
      <xs:enumeration value="engineering"/><xs:enumeration value="government"/><xs:enumeration value="magic"/>
      <xs:enumeration value="matrix"/><xs:enumeration value="media"/><xs:enumeration value="medical"/><xs:enumeration value="street"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ContactTypes">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ContactType"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="LifeModule">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="stage" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="opening"/><xs:enumeration value="adult"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="requires">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="awakened"/><xs:enumeration value="emerged"/><xs:enumeration value="adept"/><xs:enumeration value="magician"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="attributePoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="adjustmentPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="nuyen" type="xs:nonNegativeInteger"/>
    <xs:attribute name="contactPoints" type="xs:nonNegativeInteger"/>
    <!-- the contact types its contact points buy or raise (absent: any type) -->
    <xs:attribute name="contactTypes" type="sr6:ContactTypes"/>
    <xs:attribute name="knowledgeSkills" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- a rule section: <name> is its title; level 1 = chapter section … 4; parent = the enclosing section's id -->
  <xs:complexType name="Rule">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="chapter" type="xs:string" use="required"/>
      <xs:attribute name="level" use="required">
        <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="parent" type="sr6:Id"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- the kinds read from the books' own sections and tables, displayed as printed (no rules engine yet):
       docs/sr6-data-format/kinds.md, "Kinds read from sections" -->
  <!-- an entry of a kind with no attributes of its own beyond how the book groups it -->
  <xs:complexType name="Tagged">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- an action: type (minor, major, edge, boost, as the section heading words it), timing (initiative or anytime: the
       (I)/(A) after its name), edge (an Edge action or boost's cost), with (the action it goes with), category -->
  <xs:complexType name="Action">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="timing"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="initiative"/><xs:enumeration value="anytime"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="edge" type="xs:nonNegativeInteger"/>
      <xs:attribute name="with" type="xs:string"/>
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- a gear pack: its price and Essence as printed, each piece of its contents an <item> as printed -->
  <xs:complexType name="Pack">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="category" type="xs:string"/>
    <xs:attribute name="cost" type="xs:string"/>
    <xs:attribute name="essence" type="xs:string"/>
  </xs:complexType>
  <!-- a vehicle design part (a chassis, powertrain, console, size class, design modification or option, a quality
       factor): its printed columns and terms, each as printed (Double Clutch pp. 150-154) -->
  <xs:complexType name="Design">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
      <!-- its BUILD POINTS column -->
      <xs:attribute name="bp" type="xs:string"/>
      <!-- a chassis's starting values (BOD ARM HAND SEAT SIZE CLASS), a powertrain's (ACCEL SPD INT TOP SPD), a console's
           (PILOT SENSOR), each table's SPECIAL column; a size class's length, weight and cargo -->
      <xs:attribute name="body" type="xs:string"/>
      <xs:attribute name="armor" type="xs:string"/>
      <xs:attribute name="handling" type="xs:string"/>
      <xs:attribute name="seats" type="xs:string"/>
      <xs:attribute name="sizeClass" type="xs:string"/>
      <xs:attribute name="accel" type="xs:string"/>
      <xs:attribute name="interval" type="xs:string"/>
      <xs:attribute name="topSpeed" type="xs:string"/>
      <xs:attribute name="pilot" type="xs:string"/>
      <xs:attribute name="sensor" type="xs:string"/>
      <xs:attribute name="special" type="xs:string"/>
      <xs:attribute name="length" type="xs:string"/>
      <xs:attribute name="weight" type="xs:string"/>
      <xs:attribute name="cargo" type="xs:string"/>
      <!-- an option's cost is dp per level; max: the most it may be taken as printed (`4`, `2 x Body`, `min(4, Body)`);
           maxReverse: the most it may be taken in reverse when the book says (absent: max) -->
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="max" type="xs:string"/>
      <xs:attribute name="maxReverse" type="xs:string"/>
      <!-- a quality factor's cost multiplier as printed (`x2`, `x0.5`) -->
      <xs:attribute name="multiplier" type="xs:string"/>
      <!-- its cost in Design Points as printed (`2 x Armor Rating`, `+5 x Grade`): a cost field, not an effect -->
      <xs:attribute name="dp" type="xs:string"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="slots" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- an ammunition type: its modifiers and its price (a multiplier, x2, or a price) as printed -->
  <xs:complexType name="AmmoType">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="class" type="sr6:ClassKey"/>
      <xs:attribute name="category" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="ar" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- a quality path: each step's heading a <step> as printed -->
  <xs:complexType name="QualityPath">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="step" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>
  <!-- a set of qualities bought together (a metagenic collective): its Karma, the metatypes it is for and its qualities,
       as printed -->
  <xs:complexType name="QualitySet">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="quality" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="karma" type="xs:string"/>
    <xs:attribute name="metatypes" type="xs:string"/>
  </xs:complexType>
</xs:schema>
