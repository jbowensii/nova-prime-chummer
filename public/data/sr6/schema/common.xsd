<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared types for every Shadowrun 6 (SR6) data file: the entry types of each kind, so the per-kind schemas and the
     edits layer (edits.xsd) share them. Values are kept as printed, as strings; only counts, points, karma, levels and
     pages are integers. See docs/sr6-data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sr6="urn:chummer-sr6:data:1"
           targetNamespace="urn:chummer-sr6:data:1"
           elementFormDefault="unqualified">

  <xs:simpleType name="Id">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9][a-z0-9.\-]*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SourceId">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z][A-Z0-9\-]{0,19}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="True">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Bool">
    <xs:restriction base="xs:string"><xs:enumeration value="true"/><xs:enumeration value="false"/></xs:restriction>
  </xs:simpleType>
  <!-- the nine core attributes, lower case (metatype ranges); skills add mag and res -->
  <xs:simpleType name="Attr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bod"/><xs:enumeration value="agi"/><xs:enumeration value="rea"/><xs:enumeration value="str"/>
      <xs:enumeration value="wil"/><xs:enumeration value="log"/><xs:enumeration value="int"/><xs:enumeration value="cha"/>
      <xs:enumeration value="edg"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SkillAttr">
    <xs:union memberTypes="sr6:Attr">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mag"/><xs:enumeration value="res"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="Kind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="priorities"/><xs:enumeration value="metatypes"/><xs:enumeration value="attributes"/>
      <xs:enumeration value="skills"/><xs:enumeration value="qualities"/><xs:enumeration value="weapons"/>
      <xs:enumeration value="armor"/><xs:enumeration value="augmentations"/><xs:enumeration value="grades"/>
      <xs:enumeration value="electronics"/><xs:enumeration value="programs"/>
      <xs:enumeration value="gear"/><xs:enumeration value="vehicles"/><xs:enumeration value="spells"/>
      <xs:enumeration value="rituals"/><xs:enumeration value="adeptpowers"/><xs:enumeration value="complexforms"/>
      <xs:enumeration value="metamagics"/><xs:enumeration value="echoes"/><xs:enumeration value="critterpowers"/>
      <xs:enumeration value="martialarts"/><xs:enumeration value="martialtechniques"/>
      <xs:enumeration value="traditions"/>
      <xs:enumeration value="critters"/><xs:enumeration value="spirits"/><xs:enumeration value="npcs"/>
      <xs:enumeration value="sprites"/><xs:enumeration value="lifestyles"/><xs:enumeration value="contacts"/>
      <xs:enumeration value="lifemodules"/>
      <xs:enumeration value="actions"/>
      <xs:enumeration value="packs"/>
      <xs:enumeration value="vehicledesign"/>
      <xs:enumeration value="ammotypes"/>
      <xs:enumeration value="mentorspirits"/>
      <xs:enumeration value="datastructures"/>
      <xs:enumeration value="qualitypaths"/>
      <xs:enumeration value="spellfeatures"/>
      <xs:enumeration value="contacttypes"/>
      <xs:enumeration value="qualitysets"/>
      <xs:enumeration value="licencetypes"/>
      <xs:enumeration value="magictypes"/>
      <xs:enumeration value="ruleoptions"/>
      <xs:enumeration value="senses"/>
      <xs:enumeration value="trueelements"/>
      <xs:enumeration value="categories"/>
      <xs:enumeration value="rules"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- id + citation carried by every entry (page: the printed page) -->
  <xs:attributeGroup name="ref">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
    <xs:attribute name="source" type="sr6:SourceId" use="required"/>
    <xs:attribute name="page" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- overlay files delete an entry loaded before with <remove id="..."/> -->
  <xs:complexType name="Remove">
    <xs:attribute name="id" type="sr6:Id" use="required"/>
  </xs:complexType>

  <xs:attributeGroup name="version">
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:attributeGroup>

  <!-- every entry: <name>, its kind's children, its <formula>s and <issue>s, then an optional <text> (empty in imports:
       the description is in the source's texts file) -->
  <xs:group name="tail">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="formula" type="sr6:Formula"/>
        <xs:element name="issue" type="sr6:Issue"/>
        <xs:element name="found" type="sr6:Found"/>
        <!-- another name the book prints the item under (a table row's shorter name, its description heading's); or,
             with id (and kind, when it was another), an id the entry had in an earlier import: the app resolves the
             old id to this entry and turns a saved runner's old id into this one -->
        <xs:element name="alias" type="sr6:Alias"/>
        <!-- a cell's footnote: the note its footnote mark points to, for that field (the mark is left out of the value) -->
        <xs:element name="note" type="sr6:Note"/>
      </xs:choice>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="Note">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a table row's place in its category (importer/sr6/categories.py): group, the category's name when the row's own
       name needs it (a bare part: the app shows "Cyberlimb: Arm (synthetic)"); maker, the maker its product's title
       prints ("Cougar Weapons") -->
  <xs:attributeGroup name="grouped">
    <xs:attribute name="group" type="xs:string"/>
    <xs:attribute name="maker" type="xs:string"/>
    <!-- a configuration of another entry (its id): a shape that item takes, its own stats printed, never bought apart
         (the Dassault Alpenstock's spear configuration) -->
    <xs:attribute name="configOf" type="xs:string"/>
  </xs:attributeGroup>
  <!-- one category of a book's table rows (categories.xml): its name (the table's title, singular), the kind its rows
       are (of), the printed table and section titles, and how they link: an accessory category's hosts (fits) and a
       host's accessory categories (accessories), names separated by "; ". confidence="low" with why: the name came
       from the section heading (no title, a title naming no category, a title split across lines). -->
  <xs:complexType name="Category">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="of" type="sr6:Kind" use="required"/>
      <xs:attribute name="table" type="xs:string"/>
      <xs:attribute name="section" type="xs:string"/>
      <xs:attribute name="confidence"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="low"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="why" type="xs:string"/>
      <xs:attribute name="fits" type="xs:string"/>
      <xs:attribute name="accessories" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Alias">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="id" type="xs:string"/>
      <xs:attribute name="kind" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- how a field is worked out (src/engine/formula.ts): R rating, Q quantity, M Magic, B the field's printed value,
       opt.<id>; tier(), ref(kind:id, field[, R]), ceil, floor, min, max, + - * /. The attribute stays as printed.
       unit and qty: the price is for qty units ("10" "rounds"). round: up (the default) or down. -->
  <xs:simpleType name="Field">
    <xs:restriction base="xs:string"><xs:pattern value="[a-zA-Z][a-zA-Z0-9]*"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Formula">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="round"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="up"/><xs:enumeration value="down"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="unit" type="xs:string"/>
      <xs:attribute name="qty" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a field the book prints nothing for (missing), or that the importer couldn't read (unreadable, ambiguous): the
       app flags the entry until an edit or an override file sets it; page: where the book has the entry; the text: a short note -->
  <xs:complexType name="Issue">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="code" use="required"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="missing"/><xs:enumeration value="unreadable"/><xs:enumeration value="ambiguous"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="page" type="xs:positiveInteger"/>
      <!-- where the importer looked before writing it (importer/sr6/resolve.py): the book (its tables and text), and
           the corpus (every other source of the library) -->
      <xs:attribute name="searched"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="book"/><xs:enumeration value="book,corpus"/></xs:restriction></xs:simpleType></xs:attribute>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <!-- a value the entry's own row leaves out (or prints unreadably), found elsewhere (importer/sr6/resolve.py): another
       table or a sentence of the same book (how="table", "text"), another source of the library (how="corpus"), or an
       errata newer than the book (how="errata": the text is the value it replaced); source and page: where it is printed -->
  <xs:complexType name="Found">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="field" type="sr6:Field" use="required"/>
      <xs:attribute name="how" use="required"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="table"/><xs:enumeration value="text"/><xs:enumeration value="corpus"/>
        <xs:enumeration value="errata"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="source" type="sr6:SourceId"/>
      <xs:attribute name="page" type="xs:positiveInteger"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Entry">
    <xs:sequence><xs:element name="name" type="xs:string"/><xs:group ref="sr6:tail"/></xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>
  <xs:complexType name="Points">
    <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="Priority">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="metatype" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="attributes" type="sr6:Points" minOccurs="0"/>
      <xs:element name="skills" type="sr6:Points" minOccurs="0"/>
      <xs:element name="magic" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="full"/><xs:enumeration value="aspected"/><xs:enumeration value="mystic-adept"/>
              <xs:enumeration value="adept"/><xs:enumeration value="technomancer"/><xs:enumeration value="mundane"/>
            </xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="resources" minOccurs="0">
        <xs:complexType><xs:attribute name="nuyen" type="xs:nonNegativeInteger" use="required"/></xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="letter" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-E]"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="Metatype">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="range" minOccurs="0" maxOccurs="9">
        <xs:complexType>
          <xs:attribute name="attr" type="sr6:Attr" use="required"/>
          <xs:attribute name="min" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="max" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- racial qualities, by name as printed (S2 resolves them) -->
      <xs:element name="trait" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <!-- a metavariant's adjustment points at each metatype priority it can be taken at (the Sixth World Companion's
           development table): priority creation offers it at those letters, the priority table not listing it -->
      <xs:element name="priority" minOccurs="0" maxOccurs="5">
        <xs:complexType>
          <xs:attribute name="letter" use="required">
            <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-E]"/></xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>

  <xs:complexType name="Attribute">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="abbr" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="BOD"/><xs:enumeration value="AGI"/><xs:enumeration value="REA"/><xs:enumeration value="STR"/>
          <xs:enumeration value="WIL"/><xs:enumeration value="LOG"/><xs:enumeration value="INT"/><xs:enumeration value="CHA"/>
          <xs:enumeration value="EDG"/><xs:enumeration value="MAG"/><xs:enumeration value="RES"/><xs:enumeration value="ESS"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="group" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="physical"/><xs:enumeration value="mental"/><xs:enumeration value="special"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Skill">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="spec" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attr" type="sr6:SkillAttr" use="required"/>
    <xs:attribute name="untrained" type="sr6:Bool" use="required"/>
  </xs:complexType>

  <!-- a quality's effects (importer/sr6/effects.py): what its prose states, as a path from the character to a target
       (attr:<abbr>, skill:<id>, derived:<name>), an operator (add; edge-cost: Edge boosts and actions on tests with the
       target cost that much more) and a value; confidence="low": read from a sentence that sets a condition, shown and
       never applied. A test the quality calls for: skill + attribute (threshold). A choice it grants: count picks from
       the catalog's qualities of one category (max: the most the list allows). -->
  <xs:complexType name="Effect">
    <xs:attribute name="target" type="xs:string" use="required"/>
    <xs:attribute name="op" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="add"/><xs:enumeration value="edge-cost"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="confidence"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="low"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="Test">
    <xs:attribute name="skill" type="xs:string" use="required"/>
    <xs:attribute name="attr" type="xs:string" use="required"/>
    <xs:attribute name="threshold" type="xs:nonNegativeInteger"/>
  </xs:complexType>
  <xs:complexType name="QualityChoice">
    <xs:attribute name="kind" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="quality"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="count" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="max" type="xs:positiveInteger"/>
  </xs:complexType>
  <xs:complexType name="Quality">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="effect" type="sr6:Effect"/>
        <xs:element name="test" type="sr6:Test"/>
        <xs:element name="choice" type="sr6:QualityChoice"/>
      </xs:choice>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="positive"/><xs:enumeration value="negative"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <!-- karma: the lowest price printed, karmaMax: the highest when it prints a range or several (Phobia: by rarity) -->
      <xs:attribute name="karma" type="xs:integer"/>
      <xs:attribute name="karmaMax" type="xs:integer"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
      <!-- the list it is printed in (`Returned Soldier power`); granted: never bought on its own, only granted (by a
           quality's choice: Karma 0) -->
      <xs:attribute name="category" type="xs:string"/>
      <xs:attribute name="granted" type="sr6:True"/>
      <!-- the quality path a bare step heading belongs to (`Step 2` under `Quality Path: Gestalt`): the app shows
           "Gestalt: Step 2" -->
      <xs:attribute name="group" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Weapon">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <!-- the ratings (Size, Level …) a rated weapon or mount comes in, where the book prints them -->
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="modes" type="xs:string"/>
      <xs:attribute name="ar" type="xs:string"/>
      <xs:attribute name="ammo" type="xs:string"/>
      <!-- the weapon's type as printed (Unarmed, Exotic), an accessory's mount, a grenade's blast -->
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="mount" type="xs:string"/>
      <xs:attribute name="blast" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <!-- a close-combat weapon's skill and specialization, from its TYPE (Blade: Close Combat, Blades) -->
      <xs:attribute name="skill" type="xs:string"/>
      <xs:attribute name="spec" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Armor">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="defense" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Augmentation">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="cyberware"/><xs:enumeration value="bioware"/><xs:enumeration value="geneware"/><xs:enumeration value="nanoware"/><xs:enumeration value="symbionts"/><xs:enumeration value="transgenics"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="essence" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- an implant grade: its Essence and cost multipliers and Availability modifier (numbers), the augmentation types it
       is for (absent: cyberware and bioware) -->
  <xs:complexType name="Grade">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="essence" type="sr6:Decimal"/>
      <xs:attribute name="cost" type="sr6:Decimal"/>
      <xs:attribute name="avail" type="sr6:Decimal"/>
      <xs:attribute name="types">
        <xs:simpleType><xs:list><xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="cyberware"/><xs:enumeration value="bioware"/><xs:enumeration value="geneware"/>
          <xs:enumeration value="nanoware"/><xs:enumeration value="symbionts"/><xs:enumeration value="transgenics"/>
        </xs:restriction></xs:simpleType></xs:list></xs:simpleType>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="Decimal">
    <xs:restriction base="xs:string"><xs:pattern value="-?[0-9]+(\.[0-9]+)?"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Device">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="array" type="xs:string"/>
      <xs:attribute name="programs" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a Matrix program: its type as printed (basic, hacking, autosoft …); the ratings it comes in, avail and cost only
       where the book prints them -->
  <xs:complexType name="Program">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Gear">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="capacity" type="xs:string"/>
      <!-- a focus's bonding cost in Karma, a formula like the cost -->
      <xs:attribute name="karma" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <!-- what the cost buys: "10 rounds", "100m", "month" (none: one item) -->
      <xs:attribute name="per" type="xs:string"/>
      <!-- a vehicle modification's modification slots, a formula like the cost ("1/3 body (rounded up)") -->
      <xs:attribute name="slots" type="xs:string"/>
      <!-- a weapon power supply's Energy (an energy weapon's ammo formula reads it: ref(gear:<id>, energy)) -->
      <xs:attribute name="energy" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Vehicle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string" use="required"/>
      <xs:attribute name="handling" type="xs:string"/>
      <xs:attribute name="accel" type="xs:string"/>
      <xs:attribute name="interval" type="xs:string"/>
      <xs:attribute name="topSpeed" type="xs:string"/>
      <xs:attribute name="body" type="xs:string"/>
      <xs:attribute name="armor" type="xs:string"/>
      <xs:attribute name="pilot" type="xs:string"/>
      <xs:attribute name="sensor" type="xs:string"/>
      <xs:attribute name="seats" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Spell">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="combat"/><xs:enumeration value="detection"/><xs:enumeration value="health"/>
          <xs:enumeration value="illusion"/><xs:enumeration value="manipulation"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="tags" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="damage" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Ritual">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="keywords" type="xs:string"/>
      <xs:attribute name="threshold" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AdeptPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attribute name="perLevel" type="sr6:True"/>
      <xs:attribute name="maxLevel" type="xs:positiveInteger"/>
      <xs:attribute name="activation" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ComplexForm">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="duration" type="xs:string"/>
      <xs:attribute name="fade" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a martial art style: categories (Weapon, Grappling, …) and its signature technique, as printed -->
  <xs:complexType name="MartialArt">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="categories" type="xs:string"/>
      <xs:attribute name="signature" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MartialTechnique">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CritterPower">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="range" type="xs:string"/>
      <xs:attribute name="duration" type="xs:string"/>
      <!-- a weakness (Fragile, Carrier): the book's stat blocks list it under Weaknesses -->
      <xs:attribute name="weakness" type="sr6:True"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- critters, spirits and NPCs (grunts): the stat block as printed; the lists are names as printed (S2 resolves them) -->
  <xs:complexType name="Being">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:element name="optionalPowers" type="xs:string" minOccurs="0"/>
      <xs:element name="weaknesses" type="xs:string" minOccurs="0"/>
      <xs:element name="attacks" type="xs:string" minOccurs="0"/>
      <xs:element name="augmentations" type="xs:string" minOccurs="0"/>
      <xs:element name="gear" type="xs:string" minOccurs="0"/>
      <xs:element name="weapons" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="category" type="xs:string"/>
    <!-- npcs: the Professional Rating -->
    <xs:attribute name="rating" type="xs:nonNegativeInteger"/>
    <xs:attribute name="group" type="xs:string"/>
    <xs:attribute name="bod" type="xs:string"/>
    <xs:attribute name="agi" type="xs:string"/>
    <xs:attribute name="rea" type="xs:string"/>
    <xs:attribute name="str" type="xs:string"/>
    <xs:attribute name="wil" type="xs:string"/>
    <xs:attribute name="log" type="xs:string"/>
    <xs:attribute name="int" type="xs:string"/>
    <xs:attribute name="cha" type="xs:string"/>
    <xs:attribute name="ess" type="xs:string"/>
    <xs:attribute name="mag" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
    <xs:attribute name="edg" type="xs:string"/>
    <xs:attribute name="dr" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="actions" type="xs:string"/>
    <xs:attribute name="cm" type="xs:string"/>
    <xs:attribute name="move" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Sprite">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="skills" type="xs:string" minOccurs="0"/>
      <xs:element name="powers" type="xs:string" minOccurs="0"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="attack" type="xs:string"/>
    <xs:attribute name="sleaze" type="xs:string"/>
    <xs:attribute name="data" type="xs:string"/>
    <xs:attribute name="firewall" type="xs:string"/>
    <xs:attribute name="init" type="xs:string"/>
    <xs:attribute name="res" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Lifestyle">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <!-- per month -->
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Contact">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="connection" type="xs:string"/>
      <xs:attribute name="loyalty" type="xs:string"/>
      <xs:attribute name="archetype" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- a life module (lifepath creation): what it grants, as numbers; a mixed choice lists its options as tokens: an
       attribute (bod … res), skill:<skill id> or nuyen:<amount>. No prose. -->
  <xs:simpleType name="ChoiceOption">
    <xs:restriction base="xs:token">
      <xs:pattern value="bod|agi|rea|str|wil|log|int|cha|edg|mag|res|skill:[a-z0-9][a-z0-9.\-]*|nuyen:[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ChoiceOptions">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ChoiceOption"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <!-- the Sixth World Companion's contact types (a life module's, a runner's contact's) -->
  <xs:simpleType name="ContactType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="academic"/><xs:enumeration value="corporate"/><xs:enumeration value="criminal"/>
      <xs:enumeration value="engineering"/><xs:enumeration value="government"/><xs:enumeration value="magic"/>
      <xs:enumeration value="matrix"/><xs:enumeration value="media"/><xs:enumeration value="medical"/><xs:enumeration value="street"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ContactTypes">
    <xs:restriction><xs:simpleType><xs:list itemType="sr6:ContactType"/></xs:simpleType><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="LifeModule">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="choice" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="kind" use="required">
            <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mixed"/></xs:restriction></xs:simpleType>
          </xs:attribute>
          <xs:attribute name="points" type="xs:positiveInteger"/>
          <xs:attribute name="options" type="sr6:ChoiceOptions" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="stage" use="required">
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="opening"/><xs:enumeration value="adult"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="requires">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="awakened"/><xs:enumeration value="emerged"/><xs:enumeration value="adept"/><xs:enumeration value="magician"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="attributePoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="skillPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="adjustmentPoints" type="xs:nonNegativeInteger"/>
    <xs:attribute name="nuyen" type="xs:nonNegativeInteger"/>
    <xs:attribute name="contactPoints" type="xs:nonNegativeInteger"/>
    <!-- the contact types its contact points buy or raise (absent: any type) -->
    <xs:attribute name="contactTypes" type="sr6:ContactTypes"/>
    <xs:attribute name="knowledgeSkills" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- a rule section: <name> is its title; level 1 = chapter section … 4; parent = the enclosing section's id -->
  <xs:complexType name="Rule">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="chapter" type="xs:string" use="required"/>
      <xs:attribute name="level" use="required">
        <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="parent" type="sr6:Id"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- the kinds read from the books' own sections and tables, displayed as printed (no rules engine yet):
       docs/sr6-data-format.md, "Kinds read from sections" -->
  <!-- an entry of a kind with no attributes of its own beyond how the book groups it -->
  <xs:complexType name="Tagged">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- an action: type (minor, major, edge, boost, as the section heading words it), timing (initiative or anytime: the
       (I)/(A) after its name), edge (an Edge action or boost's cost), with (the action it goes with), category -->
  <xs:complexType name="Action">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="timing"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="initiative"/><xs:enumeration value="anytime"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="edge" type="xs:nonNegativeInteger"/>
      <xs:attribute name="with" type="xs:string"/>
      <xs:attribute name="category" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- a gear pack: its price and Essence as printed, each piece of its contents an <item> as printed -->
  <xs:complexType name="Pack">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="category" type="xs:string"/>
    <xs:attribute name="cost" type="xs:string"/>
    <xs:attribute name="essence" type="xs:string"/>
  </xs:complexType>
  <!-- a vehicle design part (a chassis, powertrain, console, design modification or option, a quality factor): its
       printed columns -->
  <xs:complexType name="Design">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
      <xs:attribute name="bp" type="xs:string"/>
      <xs:attribute name="rating" type="xs:string"/>
      <xs:attribute name="slots" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- an ammunition type: its modifiers and its price (a multiplier, x2, or a price) as printed -->
  <xs:complexType name="AmmoType">
    <xs:complexContent><xs:extension base="sr6:Entry">
      <xs:attribute name="category" type="xs:string"/>
      <xs:attribute name="dv" type="xs:string"/>
      <xs:attribute name="ar" type="xs:string"/>
      <xs:attribute name="avail" type="xs:string"/>
      <xs:attribute name="cost" type="xs:string"/>
      <xs:attributeGroup ref="sr6:grouped"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <!-- a quality path: each step's heading a <step> as printed -->
  <xs:complexType name="QualityPath">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="step" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
  </xs:complexType>
  <!-- a set of qualities bought together (a metagenic collective): its Karma, the metatypes it is for and its qualities,
       as printed -->
  <xs:complexType name="QualitySet">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="quality" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="sr6:tail"/>
    </xs:sequence>
    <xs:attributeGroup ref="sr6:ref"/>
    <xs:attribute name="karma" type="xs:string"/>
    <xs:attribute name="metatypes" type="xs:string"/>
  </xs:complexType>
</xs:schema>
