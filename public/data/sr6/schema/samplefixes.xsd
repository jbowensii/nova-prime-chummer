<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for kind="samplefixes": a book sample runner's printed line corrected (the edits layer only, edits.xsd's
     <samplefix>; checked alone by the importer's edits). See docs/sr6-data-format.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sr6="urn:chummer-sr6:data:1"
           targetNamespace="urn:chummer-sr6:data:1"
           elementFormDefault="unqualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="data">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="samplefix" type="sr6:SampleFix"/>
      </xs:choice>
      <xs:attribute name="kind" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="samplefixes"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="sr6:version"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
