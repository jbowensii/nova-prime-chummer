  <setting key="manySkillsQuality" value="swc.many-skills" source="SWC" page="134"/>
  <setting key="oneSkillAtMax" value="true" source="CRB" page="65"/>
  <setting key="skillPointsSpec" value="1" source="CRB" page="65"/>
  <setting key="magicMax" value="6" source="CRB" page="167"/>
  <setting key="essence" value="6" source="CRB" page="38"/>
  <setting key="contactPointsPerCha" value="6" source="CRB" page="67"/>
  <!-- the Sixth World Companion's expanded contact rules (SWC p. 161): karma for points past Charisma x 6 and past a
       contact's connection + loyalty of 2 x Charisma, no rating above 8 -->
  <setting key="contactKarma" value="1" source="SWC" page="161"/>
  <setting key="contactPairPerCha" value="2" source="SWC" page="161"/>
  <setting key="contactRatingMax" value="8" source="SWC" page="161"/>
  <setting key="knowledgePerLog" value="1" source="CRB" page="67"/>
  <setting key="maxAvailability" value="6" source="CRB" page="66"/>
  <!-- availabilityCapIllegalOnly is left unset: the first printing (2019) caps only illegal gear, the Seattle, Berlin and
       Hong Kong printings (2021-2025) every item; the latest printing wins -->
  <!-- karmaSpellsAtCreation is left unset (off): CRB p. 66's list of what the customization Karma buys names no spells,
       rituals or complex forms (Commlink6 has it as an option, off) -->
  <setting key="maxKarmaLeft" value="5" source="CRB" page="66"/>
