<?xml version="1.0" encoding="UTF-8"?>
<!-- The standard SR6 creation settings the app ships with (creation.xsd; docs/sr6-data-format.md, Creation rules): the
     numbers only, with the printed page of the book that gives each, no book text. CRB: Shadowrun, Sixth World Core
     Rulebook (CAT28000, current printing). SWC: Sixth World Companion (CAT28005): sum-to-ten, point buy, lifepath.
     FS: Firing Squad (CAT28002): martial arts.
     The server's settings are these, overlaid by the admin's changes in custom/sr6/creation.xml; a campaign's own start
     as a copy of the server's. Left unset (no book prints them): karmaToNuyenMax, skillPointsExpertise
     (an expertise at creation is bought with the customization karma at advance.expertise: CRB p. 66, step four, at p. 68's
     prices; owner, 2026-10-09), initiativeDiceMax, advance.powerPoint, advance.karmaToNuyenRate,
     advance.nuyenToKarmaRate, and the karma build (karmaBuild.*, magicKarma:*), which no SR6 book describes. -->
<sr6:creation xmlns:sr6="urn:chummer-sr6:config:1" version="1">
  <setting key="startingKarma" value="50" source="CRB" page="66"/>
  <setting key="qualityNetBonusCap" value="20" source="CRB" page="66"/>
  <setting key="qualityMaxCount" value="6" source="CRB" page="66"/>
  <setting key="oneAttributeAtMax" value="true" source="CRB" page="64"/>
  <setting key="attributeBaseMax" value="6" source="CRB" page="64"/>
  <setting key="skillCap" value="6" source="CRB" page="65"/>
  <setting key="skillCapAptitude" value="7" source="CRB" page="65"/>
  <setting key="aptitudeQuality" value="crb.aptitude-skill" source="CRB" page="70"/>
