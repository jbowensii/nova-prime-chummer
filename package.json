{
  "name": "nova-prime-chummer",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "perf": "vitest run --config vitest.perf.config.ts",
    "test:py": "node tools/python.mjs",
    "cl6check": "python -m tools.cl6check",
    "validate:data": "node tools/validate-data.mjs tests/fixtures/mini/custom --sr6=tests/fixtures/sr6/custom",
    "e2e": "playwright test",
    "check": "tsc -b && npm run validate:data && npm run coverage",
    "serve": "npm run build && node server/server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/goldman": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rethink-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "xmllint-wasm": "^5.3.0"
  }
}
